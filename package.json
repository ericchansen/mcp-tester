{
  "name": "mcp-tester",
  "version": "0.1.0",
  "description": "Instrumented MCP server + log analyzer for testing whether MCP clients honor list_changed notifications and other protocol features.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-tester-server": "./dist/server.js",
    "mcp-tester-analyze": "./dist/analyze.js",
    "mcp-tester-driver": "./dist/driver.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "analyze": "node dist/analyze.js",
    "driver": "node dist/driver.js",
    "lint": "tsc --noEmit",
    "clean": "node -e \"import('fs').then(f=>f.rmSync('dist',{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
